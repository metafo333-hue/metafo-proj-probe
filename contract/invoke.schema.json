{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mfc:invoke",
  "title": "L1 invoke 入口/出口契约",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "required": [
        "instruction"
      ],
      "properties": {
        "instruction": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "description": "客户端声明的契约版本，如 \"1\""
        },
        "context": {
          "type": "object"
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "user_token": {
          "type": "string",
          "description": "平台下发短时 token·不暴露真凭据"
        },
        "billing_context": {
          "type": "object"
        }
      }
    },
    "response": {
      "type": "object",
      "required": [
        "deliverable",
        "meta",
        "cost"
      ],
      "properties": {
        "deliverable": {
          "type": "object",
          "description": "成品。深探类(kind=video/link)为 deep_report：report(七段·免费档 s3-s7 锁) + conclusion_label(自评置信)",
          "properties": {
            "type": { "type": "string", "description": "deep_report 等" },
            "kind": { "type": "string", "description": "video / link / ..." },
            "report": {
              "type": "object",
              "description": "七段深探报告。免费档(depth=public)锁 s3-s7、headline/decision_tip 空；付费档(premium)解锁全文",
              "properties": {
                "depth": { "type": "string", "description": "public(免费) / premium(付费)" },
                "rating": { "type": ["string", "null"] },
                "headline": { "type": "string" },
                "decision_tip": { "type": "string" },
                "locked_sections": { "type": "array", "items": { "type": "string" }, "description": "免费档锁的章节(s3-s7)" },
                "unlock_hint": { "type": "string" }
              }
            },
            "conclusion_label": {
              "type": "object",
              "description": "自评置信块(certainty)·免费档亦提供，供消费方做来源分级",
              "properties": {
                "source_reliability": { "type": "string", "description": "A-D 来源可信度" },
                "info_credibility": { "type": "string", "description": "1-6 信息可信度" },
                "confidence_level": { "type": "string", "description": "High / Moderate / Low" },
                "evidence_strength": { "type": "string" },
                "verification_methods": { "type": "array", "items": { "type": "string" } },
                "aigc_flag": { "type": "boolean" }
              }
            }
          }
        },
        "meta": {
          "type": "object",
          "required": [
            "aigc_flag"
          ],
          "properties": {
            "models_used": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "data_sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "confidence": {
              "type": "number"
            },
            "duration_ms": {
              "type": "integer"
            },
            "aigc_flag": {
              "type": "boolean"
            },
            "tool_id": {
              "type": "string",
              "description": "处理该次请求的工具(审计/分账)"
            },
            "contract_version": {
              "type": "string",
              "description": "本次响应遵循的契约版本"
            },
            "geo_publishable": {
              "type": "boolean",
              "description": "结论是否可在当前地域合规发布（true=可发布，false=有合规风险需人工审核）"
            },
            "conclusion_block": {
              "type": "object",
              "description": "结构化结论块（legacy·向后兼容保留；新消费方优先用 deliverable.report + deliverable.conclusion_label）",
              "properties": {
                "headline": {
                  "type": "string",
                  "description": "一句话核心结论"
                },
                "key_points": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "3-5 条关键发现"
                },
                "data_table": {
                  "type": "object",
                  "description": "结构化数据表（键值对或嵌套 object）"
                },
                "brand_anchor": {
                  "type": "string",
                  "description": "品牌归因锚点，如 \"由 MetaProbe 情报引擎生成\""
                }
              }
            }
          }
        },
        "cost": {
          "type": "object",
          "required": [
            "base"
          ],
          "properties": {
            "base": {
              "type": "number"
            },
            "premium_data": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
