{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mfc:invoke",
  "title": "L1 invoke 入口/出口契约",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "required": [
        "instruction"
      ],
      "properties": {
        "instruction": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "description": "客户端声明的契约版本，如 \"1\""
        },
        "context": {
          "type": "object"
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "user_token": {
          "type": "string",
          "description": "平台下发短时 token·不暴露真凭据"
        },
        "billing_context": {
          "type": "object"
        }
      }
    },
    "response": {
      "type": "object",
      "required": [
        "deliverable",
        "meta",
        "cost"
      ],
      "properties": {
        "deliverable": {
          "description": "成品"
        },
        "meta": {
          "type": "object",
          "required": [
            "aigc_flag"
          ],
          "properties": {
            "models_used": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "data_sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "confidence": {
              "type": "number"
            },
            "duration_ms": {
              "type": "integer"
            },
            "aigc_flag": {
              "type": "boolean"
            },
            "tool_id": {
              "type": "string",
              "description": "处理该次请求的工具(审计/分账)"
            },
            "contract_version": {
              "type": "string",
              "description": "本次响应遵循的契约版本"
            },
            "geo_publishable": {
              "type": "boolean",
              "description": "结论是否可在当前地域合规发布（true=可发布，false=有合规风险需人工审核）"
            },
            "conclusion_block": {
              "type": "object",
              "description": "结构化结论块，供前端直接渲染",
              "properties": {
                "headline": {
                  "type": "string",
                  "description": "一句话核心结论"
                },
                "key_points": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "3-5 条关键发现"
                },
                "data_table": {
                  "type": "object",
                  "description": "结构化数据表（键值对或嵌套 object）"
                },
                "brand_anchor": {
                  "type": "string",
                  "description": "品牌归因锚点，如 \"由 MetaProbe 情报引擎生成\""
                }
              }
            }
          }
        },
        "cost": {
          "type": "object",
          "required": [
            "base"
          ],
          "properties": {
            "base": {
              "type": "number"
            },
            "premium_data": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
