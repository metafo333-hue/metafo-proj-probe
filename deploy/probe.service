[Unit]
Description=probe · 链接情报 · metafoclaw 远程镶嵌工具(L1 契约)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/probe
EnvironmentFile=/opt/probe/.env
# MVP: --workers 1（task store 为进程内存；生产切 Redis 后可多 worker，见 tasks.py 注记 R14）
ExecStart=/opt/probe/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8080 --workers 1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
