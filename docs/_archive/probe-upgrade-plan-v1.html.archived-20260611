<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>probe 升级规划 v1.0 · 北极星文档</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --blue:#1E3A8A; --orange:#FF7A1A; --ink:#111827; --sub:#6B7280;
    --line:#E5E7EB; --bg:#F7F8FA; --card:#FFFFFF;
    --green:#0F9D58; --red:#D93025; --amber:#F59E0B; --purple:#7C3AED;
    --blue-soft:#EEF2FF; --orange-soft:#FFF3E9; --green-soft:#E6F4EA;
    --red-soft:#FDECEA; --purple-soft:#F5F3FF;
    --radius:14px; --shadow:0 1px 3px rgba(16,24,40,.06),0 8px 24px rgba(16,24,40,.05);
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Microsoft YaHei", sans-serif;
    line-height: 1.7; -webkit-font-smoothing: antialiased;
  }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 40px 28px 100px; }

  /* ── HERO ── */
  h1, h2, h3, h4, .brand { font-family: "Fredoka", -apple-system, "PingFang SC", sans-serif; }
  .hero {
    position: relative; overflow: hidden;
    background: linear-gradient(135deg, #0d1e5c 0%, #1E3A8A 45%, #2547b0 100%);
    border-radius: 24px; padding: 48px 44px 44px; color: #fff; box-shadow: var(--shadow);
  }
  .hero::before {
    content: ""; position: absolute; left: -80px; bottom: -80px;
    width: 320px; height: 320px;
    background: radial-gradient(circle, rgba(255,122,26,.45), transparent 68%);
    pointer-events: none;
  }
  .hero::after {
    content: ""; position: absolute; right: -60px; top: -60px;
    width: 280px; height: 280px;
    background: radial-gradient(circle, rgba(99,140,255,.35), transparent 70%);
    pointer-events: none;
  }
  .hero-inner { position: relative; z-index: 1; }
  .hero .tag {
    display: inline-block; background: rgba(255,255,255,.14);
    border: 1px solid rgba(255,255,255,.22);
    padding: 4px 14px; border-radius: 999px; font-size: 12px;
    letter-spacing: .6px; margin-bottom: 16px; text-transform: uppercase;
  }
  .hero h1 { margin: 0 0 10px; font-size: 34px; font-weight: 700; line-height: 1.2; }
  .hero .sub-title { margin: 0 0 20px; font-size: 15.5px; opacity: .88; max-width: 680px; line-height: 1.6; }
  .hero .meta {
    display: flex; gap: 28px; flex-wrap: wrap;
    font-size: 12.5px; opacity: .9; border-top: 1px solid rgba(255,255,255,.12); padding-top: 16px;
  }
  .hero .meta span b { color: var(--orange); font-weight: 700; }

  /* ── NORTH STAR BANNER ── */
  .northstar {
    background: var(--card); border-left: 5px solid var(--orange);
    border-radius: var(--radius); padding: 18px 24px; margin: 24px 0 6px;
    box-shadow: var(--shadow); display: flex; gap: 18px; align-items: flex-start;
  }
  .northstar .icon { font-size: 28px; flex-shrink: 0; margin-top: 2px; }
  .northstar .big {
    font-family: "Fredoka"; font-size: 20px; font-weight: 700;
    color: var(--blue); line-height: 1.3; margin: 0 0 6px;
  }
  .northstar .txt { font-size: 13.5px; color: #374151; margin: 0; }

  /* ── SECTIONS ── */
  section {
    background: var(--card); border: 1px solid var(--line);
    border-radius: var(--radius); padding: 28px 30px; margin-top: 22px;
    box-shadow: var(--shadow);
  }
  .sec-h { display: flex; align-items: center; gap: 12px; margin: 0 0 4px; }
  .num {
    width: 36px; height: 36px; border-radius: 10px;
    background: var(--blue-soft); color: var(--blue);
    font-family: "Fredoka"; font-weight: 700;
    display: flex; align-items: center; justify-content: center; font-size: 16px;
    flex-shrink: 0;
  }
  .num.o { background: var(--orange-soft); color: var(--orange); }
  .num.g { background: var(--green-soft); color: var(--green); }
  .num.p { background: var(--purple-soft); color: var(--purple); }
  h2 { font-size: 21px; margin: 0; font-weight: 600; }
  .sec-desc { color: var(--sub); font-size: 13px; margin: 3px 0 22px 48px; }

  /* ── TABLE ── */
  table { width: 100%; border-collapse: collapse; font-size: 13px; margin: 8px 0; }
  th, td { text-align: left; padding: 10px 13px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { background: #FAFBFC; color: #374151; font-weight: 600; font-size: 12px; letter-spacing: .2px; }
  tr:last-child td { border-bottom: none; }
  tr:hover td { background: #FAFBFF; }

  /* ── PILLS ── */
  .pill {
    display: inline-block; padding: 2px 9px; border-radius: 999px;
    font-size: 11px; font-weight: 600; line-height: 1.75; white-space: nowrap;
  }
  .pill.g { background: var(--green-soft); color: var(--green); }
  .pill.r { background: var(--red-soft); color: var(--red); }
  .pill.a { background: #FEF3DA; color: #B45309; }
  .pill.b { background: var(--blue-soft); color: var(--blue); }
  .pill.p { background: var(--purple-soft); color: var(--purple); }
  .pill.gr { background: #F3F4F6; color: #6B7280; }

  /* ── CALLOUT NOTES ── */
  .note {
    border-radius: 10px; padding: 13px 16px; font-size: 13px; margin: 14px 0 0;
  }
  .note.warn { background: var(--orange-soft); border: 1px solid #FAD9BE; color: #9A4A06; }
  .note.info { background: var(--blue-soft); border: 1px solid #D4DCFB; color: #1e3a8a; }
  .note.success { background: var(--green-soft); border: 1px solid #B7DFC7; color: #145c34; }
  .note.danger { background: var(--red-soft); border: 1px solid #F6C9C4; color: #A52714; }
  .note b { font-weight: 700; }

  /* ── CARDS GRID ── */
  .cards-2 { display: grid; grid-template-columns: repeat(2,1fr); gap: 14px; margin-top: 8px; }
  .cards-3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 14px; margin-top: 8px; }
  .card {
    border: 1px solid var(--line); border-radius: 12px; padding: 16px 18px; background: #fff;
  }
  .card.hl { border-color: var(--blue); background: var(--blue-soft); }
  .card.hl-o { border-color: var(--orange); background: var(--orange-soft); }
  .card h4 { margin: 0 0 7px; font-size: 14.5px; color: var(--blue); font-family: "Fredoka"; font-weight: 600; }
  .card h4.o { color: var(--orange); }
  .card p { margin: 0; font-size: 12.5px; color: #4B5563; line-height: 1.6; }
  .card .kv { font-size: 12px; color: var(--sub); margin-top: 8px; }
  .card .kv b { color: var(--ink); }

  /* ── ARCH DIAGRAM ── */
  .arch {
    background: linear-gradient(135deg, #F0F4FF 0%, #FFF5EF 100%);
    border: 1px solid #dde3f7; border-radius: 16px;
    padding: 28px 24px; margin: 14px 0;
  }
  .arch-row { display: flex; gap: 12px; align-items: stretch; margin-bottom: 10px; flex-wrap: wrap; }
  .arch-row:last-child { margin-bottom: 0; }
  .arch-box {
    flex: 1; min-width: 140px;
    background: #fff; border: 1px solid var(--line); border-radius: 12px;
    padding: 14px 16px; text-align: center;
  }
  .arch-box .layer-tag {
    font-size: 10.5px; font-weight: 700; letter-spacing: .6px;
    text-transform: uppercase; color: var(--sub); margin-bottom: 6px;
  }
  .arch-box .layer-title {
    font-family: "Fredoka"; font-size: 15px; font-weight: 600; color: var(--blue); margin: 0 0 4px;
  }
  .arch-box .layer-items { font-size: 11.5px; color: #374151; line-height: 1.6; }
  .arch-box.data { border-color: #93c5fd; background: #EFF6FF; }
  .arch-box.analysis { border-color: #a78bfa; background: #F5F3FF; }
  .arch-box.output { border-color: #6ee7b7; background: #ECFDF5; }
  .arch-box.contract { border-color: #fcd34d; background: #FFFBEB; }
  .arch-arrow {
    display: flex; align-items: center; justify-content: center;
    font-size: 20px; color: var(--sub); flex-shrink: 0; padding: 0 4px;
  }

  /* ── PHASE TIMELINE ── */
  .timeline { margin: 10px 0; }
  .phase {
    border-left: 3px solid var(--line); padding: 0 0 22px 22px;
    position: relative; margin-left: 10px;
  }
  .phase:last-child { padding-bottom: 0; border-left-color: transparent; }
  .phase::before {
    content: ""; position: absolute; left: -8px; top: 4px;
    width: 14px; height: 14px; border-radius: 50%;
    background: var(--blue); border: 2px solid #fff; box-shadow: 0 0 0 2px var(--blue);
  }
  .phase.p1::before { background: var(--orange); box-shadow: 0 0 0 2px var(--orange); }
  .phase.p2::before { background: var(--sub); box-shadow: 0 0 0 2px var(--sub); }
  .phase .phase-tag {
    font-size: 11px; font-weight: 700; letter-spacing: .5px;
    text-transform: uppercase; color: var(--blue); margin-bottom: 4px;
  }
  .phase .phase-tag.p1 { color: var(--orange); }
  .phase .phase-tag.p2 { color: var(--sub); }
  .phase h3 { margin: 0 0 8px; font-size: 16px; font-weight: 600; }
  .phase ul { margin: 0; padding-left: 18px; font-size: 13px; color: #374151; }
  .phase ul li { margin-bottom: 5px; }

  /* ── DEPTH LINE ── */
  .depth-row { display: flex; gap: 0; margin: 12px 0; border-radius: 12px; overflow: hidden; border: 1px solid var(--line); }
  .depth-col { flex: 1; padding: 18px 16px; }
  .depth-col.d1 { background: #F9FAFB; border-right: 1px solid var(--line); }
  .depth-col.d2 { background: var(--blue-soft); border-right: 1px solid var(--line); }
  .depth-col.d3 { background: linear-gradient(135deg, #FFF5EF, #FFF0E3); }
  .depth-col .d-tag { font-size: 11px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; margin-bottom: 6px; }
  .depth-col.d1 .d-tag { color: var(--sub); }
  .depth-col.d2 .d-tag { color: var(--blue); }
  .depth-col.d3 .d-tag { color: var(--orange); }
  .depth-col h4 { margin: 0 0 8px; font-size: 14px; font-family: "Fredoka"; }
  .depth-col ul { margin: 0; padding-left: 16px; font-size: 12.5px; color: #374151; }
  .depth-col ul li { margin-bottom: 4px; }
  .depth-price {
    display: inline-block; margin-top: 10px;
    padding: 3px 12px; border-radius: 999px; font-size: 12px; font-weight: 700;
  }
  .d1 .depth-price { background: #E5E7EB; color: #374151; }
  .d2 .depth-price { background: var(--blue); color: #fff; }
  .d3 .depth-price { background: var(--orange); color: #fff; }

  /* ── VS COMPARE ── */
  .vs-grid { display: grid; grid-template-columns: 1fr 1fr 1fr 1.3fr; gap: 0; margin: 10px 0; border-radius: 12px; overflow: hidden; border: 1px solid var(--line); }
  .vs-col { padding: 0; }
  .vs-head { padding: 12px 14px; font-size: 13px; font-weight: 600; text-align: center; }
  .vs-head.c0 { background: #F3F4F6; color: var(--sub); }
  .vs-head.c1 { background: #F3F4F6; color: #374151; }
  .vs-head.c2 { background: #F3F4F6; color: #374151; }
  .vs-head.c3 { background: linear-gradient(135deg,#1E3A8A,#2547b0); color: #fff; }
  .vs-row { display: contents; }
  .vs-cell {
    padding: 10px 14px; font-size: 12.5px; border-top: 1px solid var(--line);
    text-align: center; color: #374151; vertical-align: top;
  }
  .vs-cell.lbl { text-align: left; font-weight: 600; color: var(--ink); background: #FAFBFC; }
  .vs-cell.hl { background: #F0F4FF; }
  .vs-cell .chk { color: var(--green); font-weight: 700; }
  .vs-cell .crs { color: var(--red); font-weight: 700; }

  /* ── COMPLIANCE RULES ── */
  .rule-list { list-style: none; margin: 0; padding: 0; }
  .rule-list li {
    display: flex; align-items: flex-start; gap: 12px;
    padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 13px;
  }
  .rule-list li:last-child { border-bottom: none; }
  .rule-icon { flex-shrink: 0; font-size: 16px; margin-top: 1px; }
  .rule-txt b { font-weight: 700; color: var(--ink); }

  /* ── FOOTER ── */
  footer {
    text-align: center; color: var(--sub); font-size: 12px;
    margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--line);
    line-height: 1.9;
  }

  @media(max-width:760px) {
    .wrap { padding: 24px 16px 60px; }
    .hero { padding: 30px 24px; }
    .hero h1 { font-size: 26px; }
    .cards-2, .cards-3 { grid-template-columns: 1fr; }
    .arch-row { flex-direction: column; }
    .depth-row, .vs-grid { flex-direction: column; display: flex; }
    section { padding: 20px 18px; }
  }
</style>
</head>
